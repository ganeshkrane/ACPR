<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">

    <Dialog
        id="idCreateAttachmentDialog"
        title="Create Attachment"
        contentWidth="600px"
        contentHeight="400px"
        draggable="true"
        resizable="true">

        <content>

            <VBox class="sapUiMediumMargin">

                

                <u:FileUploader
    id="idFileUploader"
    width="100%"
    buttonText="Browse"/>
                <Label
                    text="DESCRIPTION (OPTIONAL)"
                    class="sapUiSmallMarginTop"/>

                <TextArea
                    rows="6"
                    width="100%"
                    placeholder="Provide details about this attachment..."/>

            </VBox>

        </content>

        <beginButton>
            <Button
                text="Upload"
                type="Emphasized"
                press="onUploadAttachment"/>
        </beginButton>

        <endButton>
            <Button
                text="Close"
                press="onCloseAttachmentDialog"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>